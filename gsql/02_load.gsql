// =====================================================================
//  Loading jobs for the CSVs emitted by `python -m agent.graph_build`
//
//  Run:  gsql -g Fraud_Investigation gsql/02_load.gsql
//        RUN LOADING JOB load_fraud_graph USING
//          f_customer="data/graph/customer.csv", ...
//
//  `python -m agent.load_tigergraph --load` does this for you.
// =====================================================================
USE GRAPH Fraud_Investigation

CREATE LOADING JOB load_fraud_graph FOR GRAPH Fraud_Investigation {
  DEFINE FILENAME f_customer;
  DEFINE FILENAME f_card;
  DEFINE FILENAME f_txn;
  DEFINE FILENAME f_device;
  DEFINE FILENAME f_email;
  DEFINE FILENAME f_region;
  DEFINE FILENAME f_closed;

  DEFINE FILENAME f_owns;
  DEFINE FILENAME f_made;
  DEFINE FILENAME f_from_device;
  DEFINE FILENAME f_purchaser_email;
  DEFINE FILENAME f_billed_in;
  DEFINE FILENAME f_next;
  DEFINE FILENAME f_involves;
  DEFINE FILENAME f_on_card;
  DEFINE FILENAME f_connected_to;

  // ---- vertices ----------------------------------------------------
  LOAD f_customer TO VERTEX Customer VALUES
      ($"customer_id", $"n_cards", $"n_txns", $"first_seen", $"last_seen",
       $"home_region", $"total_spend")
      USING HEADER="true", SEPARATOR=",";

  LOAD f_card TO VERTEX Card VALUES
      ($"card_id", $"phys_card", $"customer_id", $"card1", $"network", $"card_type",
       $"n_txns", $"first_seen", $"last_seen", $"amount_median", $"amount_p95")
      USING HEADER="true", SEPARATOR=",";

  LOAD f_txn TO VERTEX Transaction VALUES
      ($"txn_id", $"ts", $"amount", $"product_cd", $"channel", $"risk_score",
       $"addr1", $"addr2", $"dist1", $"p_email", $"r_email",
       $"device_status", $"proxy_status", $"match_false_count",
       $"customer_id", $"card_id")
      USING HEADER="true", SEPARATOR=",";

  LOAD f_device TO VERTEX DeviceProfile VALUES
      ($"device_key", $"device_info", $"os", $"browser", $"screen", $"device_type",
       $"n_txns", $"n_cards_total", $"is_specific")
      USING HEADER="true", SEPARATOR=",";

  LOAD f_email  TO VERTEX EmailDomain   VALUES ($"domain", $"n_txns")
      USING HEADER="true", SEPARATOR=",";
  LOAD f_region TO VERTEX BillingRegion VALUES ($"region_code", $"country", $"n_txns", $"n_cards")
      USING HEADER="true", SEPARATOR=",";

  LOAD f_closed TO VERTEX ClosedCase VALUES
      ($"case_id", $"customer_id", $"card_id", $"opened_at", $"closed_at",
       $"outcome", $"pattern", $"n_txns", $"exposure_usd", $"actions_taken",
       $"report_filed", $"analyst_notes")
      USING HEADER="true", SEPARATOR=",", QUOTE="double";

  // ---- edges -------------------------------------------------------
  LOAD f_owns            TO EDGE OWNS            VALUES ($"customer_id", $"card_id") USING HEADER="true", SEPARATOR=",";
  LOAD f_made            TO EDGE MADE            VALUES ($"card_id", $"txn_id")      USING HEADER="true", SEPARATOR=",";
  LOAD f_from_device     TO EDGE FROM_DEVICE     VALUES ($"txn_id", $"device_key")   USING HEADER="true", SEPARATOR=",";
  LOAD f_purchaser_email TO EDGE PURCHASER_EMAIL VALUES ($"txn_id", $"domain")       USING HEADER="true", SEPARATOR=",";
  LOAD f_billed_in       TO EDGE BILLED_IN       VALUES ($"txn_id", $"region_code")  USING HEADER="true", SEPARATOR=",";
  LOAD f_next            TO EDGE NEXT            VALUES ($"a", $"b")                 USING HEADER="true", SEPARATOR=",";
  LOAD f_involves        TO EDGE INVOLVES        VALUES ($"case_id", $"txn_id")      USING HEADER="true", SEPARATOR=",";
  LOAD f_on_card         TO EDGE ON_CARD         VALUES ($"case_id", $"card_id")     USING HEADER="true", SEPARATOR=",";
  LOAD f_connected_to    TO EDGE CONNECTED_TO    VALUES ($"case_id", $"card_id")     USING HEADER="true", SEPARATOR=",";
}
